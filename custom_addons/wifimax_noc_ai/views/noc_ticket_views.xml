<odoo>

    <!-- =========================
         SEQUENCE
    ========================== -->

    <record id="seq_noc_ticket" model="ir.sequence">
        <field name="name">NOC Ticket</field>
        <field name="code">wifimax.noc.ticket</field>
        <field name="prefix">NOC-</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>


    <!-- =========================
         TREE VIEW
    ========================== -->

    <record id="view_noc_ticket_tree" model="ir.ui.view">

        <field name="name">wifimax.noc.ticket.tree</field>
        <field name="model">wifimax.noc.ticket</field>

        <field name="arch" type="xml">

            <list decoration-danger="severity == 'critical'"
                decoration-warning="severity == 'warning'">

                <field name="name"/>
                <field name="partner_id"/>
                <field name="assigned_user_id"/>
                <field name="device_ip"/>
                <field name="priority"/>
                <field name="severity"/>
                <field name="status"/>
                <field name="sla_status"/>
                <field name="detection_date"/>

            </list>

        </field>

    </record>


    <!-- =========================
         FORM VIEW
    ========================== -->

    <record id="view_noc_ticket_form" model="ir.ui.view">

        <field name="name">wifimax.noc.ticket.form</field>

        <field name="model">wifimax.noc.ticket</field>

        <field name="arch" type="xml">

            <form>

                <!-- HEADER -->

                <header>

                    <button
                        name="action_start_progress"
                        string="Iniciar"
                        type="object"
                        class="btn-primary"
                        invisible="status != '1_new'"
                    />

                    <button
                        name="action_done"
                        string="Resolver"
                        type="object"
                        class="btn-success"
                        invisible="status == '3_done'"
                    />

                    <button
                        name="action_reset"
                        string="Reabrir"
                        type="object"
                        class="btn-secondary"
                        invisible="status == '1_new'"
                    />

                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="1_new,2_progress,3_done"
                    />

                </header>


                <!-- BODY -->

                <sheet>

                    <group>

                        <field
                            name="name"
                            readonly="1"
                        />

                        <field name="partner_id"/>

                        <field name="assigned_user_id"/>

                        <field name="device_ip"/>

                        <field name="priority"/>

                        <field
                            name="severity"
                            readonly="1"
                        />

                        <field
                            name="sla_status"
                            readonly="1"
                        />

                        <field
                            name="sla_deadline"
                            readonly="1"
                        />

                        <field name="detection_date"/>

                        <field name="description"/>

                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>


    <!-- =========================
         KANBAN VIEW
    ========================== -->

    <record id="view_noc_ticket_kanban" model="ir.ui.view">

        <field name="name">wifimax.noc.ticket.kanban</field>

        <field name="model">wifimax.noc.ticket</field>

        <field name="arch" type="xml">

            <kanban
                default_group_by="status"
                groups_draggable="false"
                records_draggable="true"
            >

                <field name="name"/>

                <field name="partner_id"/>

                <field name="assigned_user_id"/>

                <field name="priority"/>

                <field name="severity"/>

                <field name="status"/>

                <field name="device_ip"/>

                <field name="sla_status"/>

                <templates>

                    <t t-name="kanban-box">

                        <div
                            t-attf-class="
                                oe_kanban_card p-3 shadow-sm
                                #{record.priority.raw_value == 'high' and 'border border-4 border-danger'}
                                #{record.priority.raw_value == 'medium' and 'border border-4 border-warning'}
                                #{record.priority.raw_value == 'low' and 'border border-4 border-success'}
                            "
                            style="
                                border-radius:12px;
                                min-height:250px;
                            "
                        >

                            <!-- TICKET -->

                            <div class="mb-3">

                                <strong style="font-size:16px;">

                                    <field name="name"/>

                                </strong>

                            </div>


                            <!-- CLIENTE -->

                            <div class="mb-2">

                                <b>Cliente:</b>

                                <span class="ms-1">

                                    <field name="partner_id"/>

                                </span>

                            </div>


                            <!-- TECNICO -->

                            <div class="mb-2">

                                <b>Técnico:</b>

                                <span class="ms-1">

                                    <field name="assigned_user_id"/>

                                </span>

                            </div>


                            <!-- IP -->

                            <div class="mb-2">

                                <b>IP:</b>

                                <span class="ms-1">

                                    <field name="device_ip"/>

                                </span>

                            </div>


                            <!-- PRIORIDAD -->

                            <div class="mb-2">

                                <b>Prioridad:</b>

                                <span class="ms-1">

                                    <field name="priority"/>

                                </span>

                            </div>


                            <!-- SEVERIDAD -->

                            <div class="mb-2">

                                <b>Severidad:</b>

                                <span class="ms-1"></span>

                                <span
                                    t-if="record.severity.raw_value == 'critical'"
                                    class="badge rounded-pill bg-danger"
                                >
                                    Crítico
                                </span>

                                <span
                                    t-if="record.severity.raw_value == 'warning'"
                                    class="badge rounded-pill bg-warning text-dark"
                                >
                                    Advertencia
                                </span>

                                <span
                                    t-if="record.severity.raw_value == 'info'"
                                    class="badge rounded-pill bg-info text-dark"
                                >
                                    Informativo
                                </span>

                            </div>


                            <!-- SLA -->

                            <div class="mt-3">

                                <b>SLA:</b>

                                <span class="ms-1"></span>

                                <span
                                    t-if="record.sla_status.raw_value == 'ok'"
                                    class="badge rounded-pill bg-success"
                                >
                                    Dentro SLA
                                </span>

                                <span
                                    t-if="record.sla_status.raw_value == 'warning'"
                                    class="badge rounded-pill bg-warning text-dark"
                                >
                                    Por vencer
                                </span>

                                <span
                                    t-if="record.sla_status.raw_value == 'expired'"
                                    class="badge rounded-pill bg-danger"
                                >
                                    Vencido
                                </span>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>

    </record>


    <!-- =========================
         SEARCH VIEW
    ========================== -->

    <record id="view_noc_ticket_search" model="ir.ui.view">

        <field name="name">wifimax.noc.ticket.search</field>

        <field name="model">wifimax.noc.ticket</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>
                <field name="partner_id"/>
                <field name="assigned_user_id"/>

                <filter
                    name="filter_new"
                    string="Nuevos"
                    domain="[('status','=','1_new')]"
                />

                <filter
                    name="filter_progress"
                    string="En Progreso"
                    domain="[('status','=','2_progress')]"
                />

                <filter
                    name="filter_done"
                    string="Resueltos"
                    domain="[('status','=','3_done')]"
                />

                <filter
                    name="filter_high"
                    string="Prioridad Alta"
                    domain="[('priority','=','high')]"
                />

                <filter
                    name="filter_medium"
                    string="Prioridad Media"
                    domain="[('priority','=','medium')]"
                />

                <filter
                    name="filter_low"
                    string="Prioridad Baja"
                    domain="[('priority','=','low')]"
                />

                <filter
                    name="filter_warning"
                    string="SLA Por Vencer"
                    domain="[('sla_status','=','warning')]"
                />

                <filter
                    name="filter_expired"
                    string="SLA Vencido"
                    domain="[('sla_status','=','expired')]"
                />

                <filter
                    name="my_tickets"
                    string="Mis Tickets"
                    domain="[('assigned_user_id','=',uid)]"
                />

                <filter
                    name="unassigned"
                    string="Sin Técnico"
                    domain="[('assigned_user_id','=',False)]"/>

                <filter string="Open"
                        name="open"
                        domain="[('status','!=','3_done')]"/>

                <filter string="Critical"
                        name="critical"
                        domain="[('severity','=','critical')]"/>

                <filter string="Expired SLA"
                        name="expired_sla"
                        domain="[('sla_status','=','expired')]"/>

            </search>

        </field>

    </record>


   <!-- =========================
            ACTION
    ========================== -->

    <record id="action_noc_ticket" model="ir.actions.act_window">

        <field name="name">NOC Tickets</field>

        <field name="res_model">wifimax.noc.ticket</field>

        <field name="search_view_id" ref="view_noc_ticket_search"/>

        <field name="view_mode">list,form,kanban,graph,pivot</field>

    </record>


    <!-- =========================
        MENUS
    ========================== -->

    <menuitem
        id="menu_wifimax_root"
        name="Wifimax NOC"
        sequence="1"
    />
    
    <menuitem
        id="menu_noc_ticket"
        name="Tickets"
        parent="menu_wifimax_root"
        action="action_noc_ticket"
        sequence="1"
    />

</odoo>